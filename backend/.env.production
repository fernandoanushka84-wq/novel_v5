# Production Environment Template
# Copy to .env and fill in actual values before deploying
ENV=production
DEBUG=false

# MySQL Configuration
MYSQL_HOST=your-production-mysql-host
MYSQL_PORT=3306
MYSQL_USER=prod_user
MYSQL_PASSWORD=your-secure-password
MYSQL_DATABASE=novel_app_db_prod

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://your-production-api.com
CORS_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Storage
UPLOAD_DIR=/var/app/uploads
MAX_UPLOAD_SIZE_MB=50

# JWT
JWT_SECRET=your-production-secret-key-minimum-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# External Services
NGROK_URL=not-used-in-production
