# Copy to .env and fill in values. MySQL is the default DB.
ENV=development
DEBUG=true
DB_TYPE=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=novel_app_db
MYSQL_SSL_DISABLED=true
MYSQL_INIT_SQL=setup_railway.sql

# If MySQL is not running locally, auto-fallback to SQLite (default true).
MYSQL_FALLBACK_SQLITE=true

# Force SQLite only (no MySQL probe):
# DB_TYPE=sqlite
# SQLITE_FILE=./novel_app.db

UPLOAD_DIR=./uploads
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin_Supun
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_EXPIRES_HOURS=24
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
