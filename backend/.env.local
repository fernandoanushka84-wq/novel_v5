# Local Development Environment
ENV=development
DEBUG=true

# MySQL Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=novel_app_db_v2

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:*,http://192.168.*.*:*

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Storage (for future file uploads)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# JWT (for future auth)
JWT_SECRET=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# External Services
NGROK_URL=https://chip-mousy-subsonic.ngrok-free.app
GOOGLE_CLIENT_ID=470949991659-avk11lvc5sv1ffietga62f8h591t7ijc.apps.googleusercontent.com
